# Copy this file to `.env` (same folder) for local development.
# `.env` is gitignored — never commit a real key.

# Groq API key. Needed only when a claim is actually processed (live submission or batch runs).
GROQ_API_KEY=

# Optional. Comma-separated browser origins allowed to call the API directly.
# The frontend normally uses its /api proxy, which doesn't need this. Default: http://localhost:3000
# CLAIMLENS_CORS_ORIGINS=http://localhost:3000

# Optional. "off" disables live claim submission; stored samples and results still work.
# The public deployment sets this to "off" so visitors can't use up the daily model allowance.
# CLAIMLENS_LIVE_SUBMISSION=on
